{
  "name": "escolaavis-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API do EscolaAvis (Node.js + Express + PostgreSQL)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "migrate": "node src/database/migrate.js up",
    "migrate:down": "node src/database/migrate.js down",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --migration-file-language sql",
    "seed": "node seeds/run.js",
    "test": "node --import ./tests/setup.js --test --test-concurrency=1 \"tests/**/*.test.js\""
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "supertest": "^7.3.1"
  }
}
