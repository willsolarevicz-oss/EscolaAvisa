# Copie para .env e preencha. NUNCA versione o .env.

# development | test | production
NODE_ENV=development
PORT=3333

# Banco principal (formato: postgres://usuario:senha@host:porta/banco)
DATABASE_URL=postgres://escolaavis:troque_esta_senha@localhost:5432/escolaavis
# Banco usado SOMENTE pelos testes automatizados (npm test). O nome precisa terminar com _test.
TEST_DATABASE_URL=postgres://escolaavis:troque_esta_senha@localhost:5432/escolaavis_test

# Segredo do JWT: no mínimo 32 caracteres aleatórios. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do token: número + unidade (s, m, h ou d). Ex.: 15m, 8h, 1d.
# Número sem unidade é recusado (o jsonwebtoken leria como milissegundos).
JWT_EXPIRES_IN=8h

# Origem(ns) do frontend liberadas no CORS (separe várias por vírgula)
FRONTEND_URL=http://localhost:5173

# Rate limit do login: tentativas falhas por IP dentro da janela
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Proxies reversos na frente da API (Nginx, load balancer, PaaS).
# false = acesso direto (desenvolvimento). Atrás de 1 proxy, use 1.
# Sem isso, atrás de proxy todos os usuários compartilham o mesmo IP no rate limit.
# "true" é recusado: permitiria forjar o IP pelo cabeçalho X-Forwarded-For.
TRUST_PROXY=false

# Opcional: senha do admin criado pelo seed. Em development, se vazio, usa Admin@123.
# Em production é OBRIGATÓRIO definir.
# SEED_ADMIN_PASSWORD=

# Opcional: BrasilAPI (feriados nacionais no calendário). Pública, sem chave.
# Se cair ou demorar mais que o timeout, o calendário funciona sem os feriados.
# BRASILAPI_URL=https://brasilapi.com.br/api
# BRASILAPI_TIMEOUT_MS=3000
