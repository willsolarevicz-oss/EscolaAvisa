# Copie para .env e preencha. NUNCA versione o .env.

# development | test | production
NODE_ENV=development
PORT=3333

# Banco principal (formato: postgres://usuario:senha@host:porta/banco)
DATABASE_URL=postgres://escolaavis:troque_esta_senha@localhost:5432/escolaavis
# Banco usado SOMENTE pelos testes automatizados (npm test). O nome precisa terminar com _test.
TEST_DATABASE_URL=postgres://escolaavis:troque_esta_senha@localhost:5432/escolaavis_test

# Segredo do JWT: no mínimo 32 caracteres aleatórios. Gere com:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Validade do token (formato do jsonwebtoken: 15m, 8h, 1d...)
JWT_EXPIRES_IN=8h

# Origem(ns) do frontend liberadas no CORS (separe várias por vírgula)
FRONTEND_URL=http://localhost:5173

# Rate limit do login: tentativas falhas por IP dentro da janela
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# Opcional: senha do admin criado pelo seed. Em development, se vazio, usa Admin@123.
# Em production é OBRIGATÓRIO definir.
# SEED_ADMIN_PASSWORD=
